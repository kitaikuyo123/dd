# MiniSQL 环境变量配置示例
# 复制此文件为 .env 并根据需要修改

# ZooKeeper 连接地址
MINISQL_ZK_CONNECT=localhost:2181

# Master 配置
MINISQL_MASTER_HOST=localhost
MINISQL_MASTER_PORT=16000

# RegionServer 配置
MINISQL_RS_HOST=localhost
MINISQL_RS_PORT=16020

# ZooKeeper 数据目录（仅使用独立 ZooKeeper 时）
MINISQL_ZK_DATA_DIR=./data/zookeeper

# ZooKeeper 端口（仅使用独立 ZooKeeper 时）
MINISQL_ZK_PORT=2181

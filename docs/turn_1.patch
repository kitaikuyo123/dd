-    private void ensureReplicationCatchUp(String regionId, ServerId replica) {
-        lifecycleManager.transition(regionId, replica,
-            ReplicaLifecycleManager.ReplicaLifecycleState.CATCHING_UP,
-            "Waiting for replica catch-up");

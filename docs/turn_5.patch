+    public static boolean isKeyInRange(byte[] key, byte[] startKey, byte[] endKey) {
+        if (key == null) {
+            return false;
+        }
+        // 检查下界
+        if (startKey != null && compareTo(key, startKey) < 0) {
+            return false;
+        }
+        // 检查上界
